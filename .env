# URBREATH Flooding Monitoring Tool: deployment settings.
# Read by docker-compose.yml in this folder. See README.md for details.

# Image version to run (tag of ghcr.io/exus-ai-labs/urbreath-flooding-model).
URBREATH_VERSION=1.1.0

# Host interface the ports are published on. 0.0.0.0 = all interfaces;
# use 127.0.0.1 if a reverse proxy on the same host fronts the services.
URBREATH_BIND_ADDRESS=0.0.0.0

# Host ports for the prediction API and the dashboard.
URBREATH_API_PORT=8001
URBREATH_UI_PORT=8501

# REQUIRED. Secret for the /pipeline/* maintenance endpoints (sent as the
# X-API-Key header). Generate a random value, e.g.:  openssl rand -hex 32
# The tool will not start while this is empty. Don't commit your filled-in key.
URBREATH_PIPELINE_API_KEY=

# Optional: outbound proxy for the dashboard's live river-level feed, e.g.
# HTTPS_PROXY=http://proxy.example.org:3128
HTTPS_PROXY=
NO_PROXY=
